# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kigalihomes

# Auth
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# Client
CLIENT_URL=http://localhost:5173

# Cloudinary (property images/videos, profile pictures) — free account at cloudinary.com,
# these three values are on your Cloudinary dashboard homepage after signing up.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
